# ============================================================
# BCWork — Variables de entorno
# Copiar a .env.local y completar con valores reales
# NUNCA commitear este archivo con valores reales
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_PROJECT_ID=arixdgwvqiijllkrnihm

# JWT Secret del proyecto Supabase (Dashboard -> Settings -> API).
# Se usa para firmar el token con el que la app consulta como rol `authenticated`,
# de modo que las politicas RLS se apliquen de verdad.
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# Interruptor del aislamiento por RLS.
#   false / ausente -> la app consulta con service_role (BYPASSRLS). El
#                      aislamiento depende del filtro por tenant_id en cada query.
#   true            -> las consultas de tenant van como `authenticated` y el RLS
#                      las aisla aunque una query olvide filtrar.
# Requiere SUPABASE_JWT_SECRET. Encender primero en preview, no en produccion.
TENANT_RLS_ENFORCED=false

# --- Auth JWT (generar con: openssl rand -base64 64) ---
JWT_SECRET=<random-64-bytes-base64>
JWT_REFRESH_SECRET=<random-64-bytes-base64>

# --- Cifrado PII (pgcrypto key — rotar via Supabase Vault en prod) ---
PII_ENCRYPTION_KEY=<random-32-bytes-hex>

# --- Email (Resend) ---
RESEND_API_KEY=re_placeholder
EMAIL_FROM=noreply@bcwork.co

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=https://placeholder@sentry.io/placeholder
SENTRY_ORG=bc-fabric-sas
SENTRY_PROJECT=bcwork-web

# --- Upstash (rate limiting) ---
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
